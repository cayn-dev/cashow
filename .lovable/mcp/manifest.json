{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://eyuzazeavwbtdymmviyh.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cashow-mcp",
      "version": "0.1.0",
      "title": "Cashow"
    },
    "tools": [
      {
        "name": "list_transactions",
        "title": "List transactions",
        "description": "List the signed-in user's Cashow transactions. Optional filters: type (income/expense), category, from/to ISO dates, and limit (default 50, max 500).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "category": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "description": "ISO date (inclusive)"
            },
            "to": {
              "type": "string",
              "description": "ISO date (inclusive)"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Create transaction",
        "description": "Add a new income or expense transaction to Cashow for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "income",
                "expense"
              ]
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category": {
              "type": "string",
              "description": "Category slug, e.g. groceries, salary, rent"
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "date": {
              "type": "string",
              "description": "ISO date; defaults to today"
            },
            "payment_method": {
              "type": "string",
              "enum": [
                "cash",
                "card",
                "paypal",
                "transfer",
                "other"
              ]
            },
            "is_salary": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "amount",
            "category",
            "description"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_transaction",
        "title": "Delete transaction",
        "description": "Permanently delete a Cashow transaction by ID.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "monthly_summary",
        "title": "Monthly summary",
        "description": "Return the signed-in user's income, expenses, balance and per-category breakdown for a given month (YYYY-MM, defaults to current month).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "YYYY-MM, defaults to current month"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_savings_goals",
        "title": "List savings goals",
        "description": "List the signed-in user's Cashow savings goals with progress.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
